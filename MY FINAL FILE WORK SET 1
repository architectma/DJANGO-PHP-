        "from vault_utils import *\n",
        "from vault_main import load_users, save_users, log_event\n",
        "\n",
        "def register_user():\n",
        "    users = load_users()\n",
        "    uname = input(\"Enter new username: \")\n",
        "\n",
        "    if not valid_username(uname):\n",
        "        print(\"Invalid username\")\n",
        "        return\n",
        "\n",
        "    if uname in users:\n",
        "        print(\"Username already exists\")\n",
        "        return\n",
        "\n",
        "    passwd = input(\"Enter password: \")\n",
        "    if not is_strong_password(passwd):\n",
        "        print(\"Password too weak\")\n",
        "        return\n",
        "\n",
        "    users[uname] = {\n",
        "        \"passwd_hash\": hash_password(passwd),\n",
        "        \"funds\": 0.0,\n",
        "        \"recovery_pin\": generate_recovery()\n",
        "    }\n",
        "\n",
        "    save_users(users)\n",
        "    log_event(f\"USER REGISTERED: {uname}\")\n",
        "    print(\"Account created successfully\")\n",
        "    print(\"Recovery PIN:\", users[uname][\"recovery_pin\"])"
