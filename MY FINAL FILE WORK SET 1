        "def user_dashboard(uname, users):\n",
        "    while True:\n",
        "        print(\"\\n1. Check Funds 2. Deposit 3. Withdraw 4. Change Password 5. Logout\")\n",
        "        choice = input(\"Select option: \")\n",
        "\n",
        "        if choice == \"1\":\n",
        "            print(\"Current funds:\", users[uname][\"funds\"])\n",
        "\n",
        "        elif choice == \"2\":\n",
        "            amt = float(input(\"Deposit amount: \"))\n",
        "            if amt > 0:\n",
        "                users[uname][\"funds\"] += amt\n",
        "                save_users(users)\n",
        "                log_event(f\"DEPOSIT {amt} -> {uname}\")\n",
        "\n",
        "        elif choice == \"3\":\n",
        "            amt = float(input(\"Withdraw amount: \"))\n",
        "            if 0 < amt <= users[uname][\"funds\"]:\n",
        "                users[uname][\"funds\"] -= amt\n",
        "                save_users(users)\n",
        "                log_event(f\"WITHDRAW {amt} -> {uname}\")\n",
        "            else:\n",
        "                print(\"Invalid amount\")\n",
        "\n",
        "        elif choice == \"4\":\n",
        "            new_pass = input(\"New password: \")\n",
        "            if not is_strong_password(new_pass):\n",
        "                print(\"Weak password\")\n",
        "                continue\n",
        "\n",
        "            users[uname][\"passwd_hash\"] = hash_password(new_pass)\n",
        "            save_users(users)\n",
        "            log_event(f\"PASSWORD UPDATED: {uname}\")\n",
        "\n",
        "        elif choice == \"5\":\n",
        "            break"
      ],
